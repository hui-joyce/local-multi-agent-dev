# LangSmith tracing (optional) 
LANGSMITH_API_KEY=your_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=local-multi-agent-dev

# IDA Pro integration (RE) 
IDA_PATH=your_ida_path
IDA_RPC_SCRIPT_PATH=your_ida_rpc_script_path

# Cloud API Keys (if using cloud models instead of local MLX)
GEMINI_API_KEY=your_gemini_api_key

# Firmware extraction (optional) 
# Only required for IPSW extraction that needs sudo
# Prefer NOPASSWD sudoers for `ipsw` instead of storing a password
# IPSW_SUDO_PASSWORD=