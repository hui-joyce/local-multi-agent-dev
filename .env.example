# Local-only mode
HF_HUB_OFFLINE=1

# MODELS_DIR=./models

# SECURITY_NOTES_DIR=./data/security_notes

# IDA Pro
IDA_PATH=/Applications/IDA Professional 9.1.app/Contents/MacOS/idat
IDA_RPC_SCRIPT_PATH=/absolute/path/to/repo/langgraph_orchestration/tooling/ida_rpc_server.py

# Interfaces (optional)
# API_HOST=127.0.0.1
# API_PORT=8000
# API_RELOAD=false
# APP_HOST=127.0.0.1
# APP_PORT=7860
# LOG_LEVEL=INFO

# Chat history (optional)
# CHAT_HISTORY_DIR=
# CHAT_HISTORY_FILE=

# RAG (optional)
# RAG_DB_PATH=~/.local/share/qdrant
# RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# RAG_EMBEDDING_DEVICE=          # auto: mps > cuda > cpu
# RAG_EMBEDDING_CACHE_DIR=~/.cache/huggingface
# RAG_DEFAULT_TOP_K=5
# RAG_SCORE_THRESHOLD=0.3
# RAG_ENABLE_FALLBACK=true

# Firmware analysis
# IPSW_DOWNLOADS_API_ENABLE=1

# Required only if `ipsw extract` needs sudo. Prefer a NOPASSWD sudoers rule.
# IPSW_SUDO_PASSWORD=

# IPSW_DIFF_LOW_MEMORY=1
# IPSW_DIFF_INCLUDE_METAL=1

# Resume feature analysis by skipping completed components.
# FEATURE_ANALYSIS_RESUME=1

# Debugging
# RE_DEBUG=1            # feature-analysis prompts and outputs
# RE_AUTODECOMP_DEBUG=1 # auto-decompile resolution
# RE_ANNOT_DEBUG=1      # IDA annotation floor

# Jenkins pipeline
# PIPELINE_DEVICES=iPhone18,1
# PIPELINE_DEVICE_FAMILY=iPhone
# PIPELINE_KEEP_PER_DEVICE=1
# PIPELINE_DOWNLOAD_TIMEOUT=14400
# PIPELINE_STALE_PARTIAL_DAYS=7

# LangSmith (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=local-multi-agent-dev

# Gemini (optional)
# GEMINI_API_KEY=